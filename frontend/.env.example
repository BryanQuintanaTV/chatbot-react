# API Configuration
VITE_API_URL='http://localhost:8000/api/v1/chat'

# App Version
CHATBOT_VERSION='0.0.2'

# System Status
# Set to 'true' to enable maintenance mode - blocks all access and shows maintenance page
VITE_MAINTENANCE_MODE=false
# ISO 8601 datetime when maintenance will end (optional) - e.g., 2024-12-01T10:00:00Z
VITE_MAINTENANCE_END_TIME=
# Comma-separated list of whitelisted IPs that can bypass maintenance mode
# Supports exact IPs, CIDR notation, and wildcards
# Examples:
#   - Exact IPs: '192.168.1.1,10.0.0.5'
#   - CIDR: '192.168.1.0/24'
#   - Wildcards: '192.168.1.*'
#   - Mixed: '192.168.1.1,10.0.0.0/8,172.16.*'
VITE_MAINTENANCE_WHITELIST_IPS=

# Backend Health Check
# Set to 'true' to enable automatic backend health monitoring
VITE_ENABLE_BACKEND_HEALTH_CHECK=false

# Read-Only Mode
# Set to 'true' to enable read-only mode - users can view but not send messages or edit chats
VITE_READ_ONLY_MODE=false